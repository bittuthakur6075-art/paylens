# PayLens - Environment Variables Example

# Supabase Cloud Database & Storage (Recommended)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Google Sheets Backend Webhook URL (Optional fallback)
VITE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/your-deployment-id/exec"

# Google Gemini Flash Vision API Key (Optional)
VITE_GEMINI_API_KEY=""
